{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog product",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "costPriceBDT": { "type": "number" },
        "retailPriceBDT": { "type": "number" },
        "stock": { "type": "number" }
      },
      "required": ["title", "category", "retailPriceBDT"]
    },
    "DiaryLedgerEntry": {
      "title": "Diary Ledger Entry",
      "description": "Store transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "partyName": { "type": "string" },
        "amountBDT": { "type": "number" }
      },
      "required": ["id", "date", "type", "partyName", "amountBDT"]
    },
    "DealerAccount": {
      "title": "Dealer Account",
      "description": "Supplier contact and payable data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dealerName": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id", "dealerName", "phone"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order and dispatch data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "codAmountBDT": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerName", "codAmountBDT", "status"]
    }
  },
  "firestore": {
    "users/{uid}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Catalog products"
    },
    "ledger/{entryId}": {
      "schema": { "$ref": "DiaryLedgerEntry" },
      "description": "Store ledger entries"
    },
    "dealers/{dealerId}": {
      "schema": { "$ref": "DealerAccount" },
      "description": "Dealer accounts"
    },
    "orders/{orderId}": {
      "schema": { "$ref": "Order" },
      "description": "Customer orders"
    }
  }
}
